{
  "name": "opencode-cloak-fetch",
  "version": "1.1.2",
  "description": "OpenCode plugin that replaces webfetch with CloakBrowser-backed fetching.",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "cloakbrowser",
    "webfetch"
  ],
  "author": "PartMent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/partment/opencode-cloak-fetch.git"
  },
  "bugs": {
    "url": "https://github.com/partment/opencode-cloak-fetch/issues"
  },
  "homepage": "https://github.com/partment/opencode-cloak-fetch#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20",
    "opencode": ">=1.3.8"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.15.0",
    "cloakbrowser": "0.3.28",
    "jsonc-parser": "3.3.1",
    "puppeteer-core": "24.43.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
